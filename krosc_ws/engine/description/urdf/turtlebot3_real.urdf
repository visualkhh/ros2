<?xml version="1.0" ?>
<!-- ROBOTIS turtlebot3_manipulation URDF 기반: stock base/arm + design D435 mount. -->
<robot name="turtlebot3_waffle_pi" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- <xacro:include filename="$(find turtlebot3_description)/urdf/common_properties.urdf"/> -->

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="arm_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="${namespace}base_footprint"/>

  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link" />
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_link">
    <!-- 메쉬를 못 읽는 뷰어(웹/Qt)용 몸체 프록시: collision과 동일 -->
    <visual>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.3729096e+00"/>
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
               iyy="8.6195418e-03" iyz="-3.5422299e-06"
               izz="1.4612727e-02" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_left_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="${namespace}wheel_right_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="${namespace}caster_back_right_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_right_link"/>
    <origin xyz="-0.177 -0.064 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_right_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="${namespace}caster_back_left_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_left_link"/>
    <origin xyz="-0.177 0.064 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_left_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="${namespace}imu_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}imu_link"/>

  <!-- LDS scan frame (ROBOTIS turtlebot3_manipulation) -->
  <joint name="${namespace}scan_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}base_scan"/>
    <origin xyz="-0.024 0 0.122" rpy="0 0 0"/>
  </joint>
  <link name="${namespace}base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0397 0.0547 0.034"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0397 0.0547 0.034"/></geometry>
    </collision>
    <inertial>
      <mass value="0.042"/><origin xyz="0 0 0"/>
      <inertia ixx="0.00001452" ixy="0.0" ixz="0.0" iyy="0.00000956" iyz="0.0" izz="0.00001599"/>
    </inertial>
  </link>

  <!-- RealSense D435: stock turtlebot3_manipulation mount (design/D435). -->
  <joint name="${namespace}camera_joint" type="fixed">
    <origin xyz="0.1061547 0 0.065" rpy="0 0 0"/>
    <parent link="${namespace}base_link"/>
    <child link="${namespace}camera_bottom_screw_frame"/>
  </joint>
  <link name="${namespace}camera_bottom_screw_frame"/>

  <joint name="${namespace}camera_link_joint" type="fixed">
    <origin xyz="0.0106 0.0175 0.0125" rpy="0 0 0"/>
    <parent link="${namespace}camera_bottom_screw_frame"/>
    <child link="${namespace}camera_link"/>
  </joint>
  <link name="${namespace}camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02505 0.09 0.025"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02505 0.09 0.025"/></geometry>
    </collision>
    <inertial><mass value="0.072"/><origin xyz="0 0 0"/><inertia ixx="0.003881243" ixy="0" ixz="0" iyy="0.00049894" iyz="0" izz="0.003879257"/></inertial>
  </link>

  <joint name="${namespace}d435_mount_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${namespace}camera_bottom_screw_frame"/>
    <child link="${namespace}d435_mount"/>
  </joint>
  <link name="${namespace}d435_mount">
    <visual>
      <origin xyz="-0.040 0 0.0125" rpy="0 0 0"/>
      <geometry><box size="0.142 0.091 0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="-0.040 0 0.0125" rpy="0 0 0"/>
      <geometry><box size="0.142 0.091 0.025"/></geometry>
    </collision>
    <inertial><mass value="0.040"/><origin xyz="-0.040 0 0.025"/><inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00012"/></inertial>
  </link>

  <joint name="${namespace}camera_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${namespace}camera_link"/><child link="${namespace}camera_depth_frame"/>
  </joint>
  <link name="${namespace}camera_depth_frame"/>
  <joint name="${namespace}camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="${namespace}camera_depth_frame"/><child link="${namespace}camera_depth_optical_frame"/>
  </joint>
  <link name="${namespace}camera_depth_optical_frame"/>

  <joint name="${namespace}camera_color_joint" type="fixed">
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
    <parent link="${namespace}camera_link"/><child link="${namespace}camera_color_frame"/>
  </joint>
  <link name="${namespace}camera_color_frame"/>
  <joint name="${namespace}camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="${namespace}camera_color_frame"/><child link="${namespace}camera_color_optical_frame"/>
  </joint>
  <link name="${namespace}camera_color_optical_frame"/>

  <joint name="${namespace}camera_infra1_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${namespace}camera_link"/><child link="${namespace}camera_infra1_frame"/>
  </joint>
  <link name="${namespace}camera_infra1_frame"/>
  <joint name="${namespace}camera_infra1_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="${namespace}camera_infra1_frame"/><child link="${namespace}camera_infra1_optical_frame"/>
  </joint>
  <link name="${namespace}camera_infra1_optical_frame"/>

  <joint name="${namespace}camera_infra2_joint" type="fixed">
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <parent link="${namespace}camera_link"/><child link="${namespace}camera_infra2_frame"/>
  </joint>
  <link name="${namespace}camera_infra2_frame"/>
  <joint name="${namespace}camera_infra2_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="${namespace}camera_infra2_frame"/><child link="${namespace}camera_infra2_optical_frame"/>
  </joint>
  <link name="${namespace}camera_infra2_optical_frame"/>

  <!-- ===== OpenMANIPULATOR-X (ROBOTIS, 4 DOF + gripper, 손목 roll 없음) ===== -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="link1"/>
    <origin xyz="-0.092 0 0.091" rpy="0 0 0"/>
  </joint>

<link name="link1">
    <visual>
      <origin xyz="0 0 0.0202" rpy="0 0 0" />
      <geometry><box size="0.045 0.045 0.042" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="3.0876154e-04 0.0000000e+00 -1.2176461e-04" />
      <mass value="7.9119962e-02" />
      <inertia ixx="1.2505234e-05" ixy="0.0" ixz="-1.7855208e-07" iyy="2.1898364e-05" iyz="0.0" izz="1.9267361e-05" />
    </inertial>
  <collision><origin xyz="0 0 0.0202" rpy="0 0 0" /><geometry><box size="0.047 0.029 0.041" /></geometry></collision></link>

<link name="link2">
    <visual>
      <origin xyz="0 0 0.0509" rpy="0 0 0" />
      <geometry><box size="0.032 0.032 0.060" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="-3.0184870e-04 5.4043684e-04 0.047433463999999995" />
      <mass value="9.8406837e-02" />
      <inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07" iyy="3.2689329e-05" iyz="2.8511935e-08" izz="1.8850320e-05" />
    </inertial>
  <collision><origin xyz="0 0 0.0509" rpy="0 0 0" /><geometry><box size="0.047 0.042 0.064" /></geometry></collision></link>

<link name="link3">
    <visual>
      <origin xyz="0.0137 0 0.0658" rpy="0 0 0" />
      <geometry><box size="0.042 0.030 0.170" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01" />
      <mass value="1.3850917e-01" />
      <inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05" iyy="3.4290447e-04" iyz="-1.5717516e-06" izz="6.0346498e-05" />
    </inertial>
  <collision><origin xyz="0.0137 0 0.0658" rpy="0 0 0" /><geometry><box size="0.067 0.052 0.172" /></geometry></collision></link>

<link name="link4">
    <visual>
      <origin xyz="0.0637 0 0" rpy="0 0 0" />
      <geometry><box size="0.150 0.034 0.034" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="9.0909590e-02 3.8929816e-04 2.2413279e-04" />
      <mass value="1.3274562e-01" />
      <inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07" iyy="2.4230292e-04" iyz="1.1559550e-08" izz="2.5155057e-04" />
    </inertial>
  <collision><origin xyz="0.0637 0 0" rpy="0 0 0" /><geometry><box size="0.167 0.053 0.047" /></geometry></collision></link>

<link name="link5">
    <visual>
      <origin xyz="0.0242 0 0.0084" rpy="0 0 0" />
      <geometry><box size="0.070 0.055 0.050" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="4.4206755e-02 3.6839985e-07 8.9142216e-03" />
      <mass value="1.4327573e-01" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06" iyy="7.5980465e-05" iyz="0.0" izz="9.3127351e-05" />
    </inertial>
  <collision><origin xyz="0.0242 0 0.0084" rpy="0 0 0" /><geometry><box size="0.088 0.129 0.063" /></geometry></collision></link>

<link name="gripper_left_link">
    <visual>
      <origin xyz="0.021 0.0078 0" rpy="0 0 0" />
      <geometry><box size="0.070 0.016 0.042" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="1.0e-03" />
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" />
    </inertial>
  <collision><origin xyz="0.021 0.0078 0" rpy="0 0 0" /><geometry><box size="0.088 0.040 0.058" /></geometry></collision></link>

<link name="gripper_right_link">
    <visual>
      <origin xyz="0.021 -0.0078 0" rpy="0 0 0" />
      <geometry><box size="0.070 0.016 0.042" /></geometry>
      <material name="arm_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="1.0e-03" />
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" />
    </inertial>
  <collision><origin xyz="0.021 -0.0078 0" rpy="0 0 0" /><geometry><box size="0.088 0.040 0.058" /></geometry></collision></link>

<link name="end_effector_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        </material>
    </visual>
  </link>

<joint name="joint1" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin rpy="0 0 0" xyz="0.012 0.0 0.017" />
    <axis xyz="0 0 1" />
    <limit effort="1" lower="-2.827433388230814" upper="2.827433388230814" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>

<joint name="joint2" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0595" />
    <axis xyz="0 1 0" />
    <limit effort="1" lower="-1.790707812546182" upper="1.5707963267948966" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>

<joint name="joint3" type="revolute">
    <parent link="link3" />
    <child link="link4" />
    <origin rpy="0 0 0" xyz="0.024 0 0.128" />
    <axis xyz="0 1 0" />
    <limit effort="1" lower="-0.9424777960769379" upper="1.382300767579509" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>

<joint name="joint4" type="revolute">
    <parent link="link4" />
    <child link="link5" />
    <origin rpy="0 0 0" xyz="0.124 0.0 0.0" />
    <axis xyz="0 1 0" />
    <limit effort="1" lower="-1.790707812546182" upper="2.0420352248333655" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>

<joint name="gripper_left_joint" type="prismatic">
    <parent link="link5" />
    <child link="gripper_left_link" />
    <origin rpy="0 0 0" xyz="0.0817 0.021 0.0" />
    <axis xyz="0 1 0" />
    <limit effort="1" lower="-0.010" upper="0.019" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>

<joint name="gripper_right_joint" type="prismatic">
    <parent link="link5" />
    <child link="gripper_right_link" />
    <origin rpy="0 0 0" xyz="0.0817 -0.021 0" />
    <axis xyz="0 -1 0" />
    <limit effort="1" lower="-0.010" upper="0.019" velocity="4.8" />
    <dynamics damping="0.1" />
    <mimic joint="gripper_left_joint" multiplier="1" />
  </joint>

<joint name="end_effector_joint" type="fixed">
    <parent link="link5" />
    <child link="end_effector_link" />
    <origin rpy="0 0 0" xyz="0.126 0.0 0.0" />
  </joint>

</robot>
