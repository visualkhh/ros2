# 외부 소스 의존성 (vcstool 형식) — apt에 없어서 소스로 받아 우리 워크스페이스에서 Lyrical로 빌드하는 것만.
#   권장: ~/ros2/setup/pi/build.sh (vcs import + rosdep install + patches/*.patch 적용 + colcon build까지 한 번에)
#   수동: cd ros2_ws && vcs import src < deps.repos && rosdep install --from-paths src --ignore-src -r -y \
#     && (cd src/cartographer && patch -p1 < ../../patches/cartographer-ceres2.patch) \
#     && (cd src/cartographer_ros && patch -p1 < ../../patches/cartographer_ros-ceres2.patch) \
#     && colcon build --symlink-install --parallel-workers 2 --cmake-args -DCMAKE_POLICY_VERSION_MINIMUM=3.5
#   받은 폴더(src/coin_d4_driver/ · src/m-explore-ros2/ · src/cartographer/ · src/cartographer_ros/)는 .gitignore — 이 파일만 커밋한다.
#
# version = 그 저장소의 git 브랜치/커밋 (ROS 배포판 설정이 아님).
#   ROBOTIS는 humble · jazzy · main 브랜치만 있고 lyrical 브랜치는 없음 → 코드가 같은 최신(jazzy 끝 = main + 머지 커밋)을
#   커밋으로 고정. 순수 rclcpp/sensor_msgs 코드라 Lyrical에서 소스 빌드하면 됨.
repositories:
  coin_d4_driver:   # LDS-03 라이다 드라이버 (turtlebot3_bringup LDS_MODEL=LDS-03과 같은 것)
    type: git
    url: https://github.com/ROBOTIS-GIT/coin_d4_driver.git
    version: 79d183324729f0c1881f11ef431b6384c1aef957   # 2025-07-14 (jazzy 브랜치 끝)
  m-explore-ros2:   # 자동 맵핑 frontier 탐색 (explore_lite + explore_lite_msgs). BSD. Lyrical apt에 없음 → 소스 빌드
    type: git
    url: https://github.com/robo-friends/m-explore-ros2.git
    version: 326cf8a0b487c34246bb8f3326afbcd69576dc60   # 2026-06-02 main (Lyrical 빌드 확인)
  cartographer:   # Google Cartographer 코어 (SLAM). Lyrical apt(resolute)에 없음 → 소스 빌드. ceres 등은 apt.
    type: git
    url: https://github.com/cartographer-project/cartographer.git
    version: 877157a0d91788a7700221d87232d412cb3c1ef4
  cartographer_ros:   # Cartographer ROS 2 래퍼. 위 코어와 같은 시기 ros2 브랜치로 고정
    type: git
    url: https://github.com/ros2/cartographer_ros.git
    version: 743345256b43a7fd95765d40c7332b6f31ab66bb
