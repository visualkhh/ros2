<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_bringup</name>
  <version>0.1.0</version>
  <description>TurtleBot3-style bringup: OpenCR driver (robot.launch.py), PC RL nodes (rl.launch.py), mock base for PC test.</description>
  <maintainer email="pank@example.com">pank</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rl_correction</exec_depend>
  <exec_depend>rl_eval</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
