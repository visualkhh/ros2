<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_bringup</name>
  <version>0.1.0</version>
  <description>TurtleBot3 Waffle Pi bringup: state/cmd managers, OpenCR driver, LDS-03 lidar, explore_lite bridge (auto mapping), PC RL nodes (rl-only).</description>
  <maintainer email="pank@example.com">pank</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>explore_lite</exec_depend>
  <exec_depend>explore_lite_msgs</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <!-- coin_d4_driver (LDS-03): apt에 없음 → ros2_ws/deps.repos. 없으면 launch가 라이다만 건너뜀 -->
  <exec_depend>rl_correction</exec_depend>
  <exec_depend>rl_eval</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
