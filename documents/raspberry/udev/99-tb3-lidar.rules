# LDS-03 (USB2LDS = Silicon Labs CP2102) → /dev/tb3_lidar 고정 이름. coin_d4_driver 기본 포트와 같음 (turtlebot3 udev 규칙과 같은 이름).
# 설치: ./install-udev.sh (이 폴더) · 설명: ../udev-setup.md
# 주의: CP2102는 흔한 USB-시리얼 칩 — 같은 칩의 다른 장치를 꽂으면 그것도 tb3_lidar가 될 수 있음.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="tb3_lidar", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
