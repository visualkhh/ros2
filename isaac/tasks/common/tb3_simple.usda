#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

# Minimal 2-wheel diff-drive robot (Waffle Pi scale).
# forward = +X, left = +Y. Wheels spin about +Y: positive joint vel = backward
# (env negates: joint_vel = -v_wheel / r).
def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1.2
        double3 xformOp:translate = (0, 0, 0.075)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.85, 0.35, 0.1)]
            float3 xformOp:scale = (0.22, 0.18, 0.05)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            double size = 1
        }

        def Sphere "caster" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double3 xformOp:translate = (-0.09, 0, -0.06)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            double radius = 0.015
        }
    }

    def Xform "left_wheel" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.1
        double3 xformOp:translate = (0, 0.1435, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.08, 0.08, 0.08)]
            uniform token axis = "Y"
            double radius = 0.033
            double height = 0.02
        }
    }

    def Xform "right_wheel" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.1
        double3 xformOp:translate = (0, -0.1435, 0.033)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.08, 0.08, 0.08)]
            uniform token axis = "Y"
            double radius = 0.033
            double height = 0.02
        }
    }

    def PhysicsRevoluteJoint "left_wheel_joint"
    {
        rel physics:body0 = </Robot/chassis>
        rel physics:body1 = </Robot/left_wheel>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0, 0.1435, 0.033)
        point3f physics:localPos1 = (0, 0, 0)
    }

    def PhysicsRevoluteJoint "right_wheel_joint"
    {
        rel physics:body0 = </Robot/chassis>
        rel physics:body1 = </Robot/right_wheel>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0, -0.1435, 0.033)
        point3f physics:localPos1 = (0, 0, 0)
    }
}
