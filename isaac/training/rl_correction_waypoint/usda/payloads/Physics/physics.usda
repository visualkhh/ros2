#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tb3_waffle_pi_lowlidar"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tb3_waffle_pi_lowlidar"
{
    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.009, 0.009, 0.0165, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (-0.064, 0, 0.03)
                float3 physics:diagonalInertia = (0.009, 0.009, 0.0165)
                float physics:mass = 1.4
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "wheel_left_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.000011, 0.0000205, 0.000011, 0, 0, 0]
                    float3 physics:diagonalInertia = (0.000011, 0.000011, 0.0000205)
                    float physics:mass = 0.0285
                    quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "wheel_right_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.000011, 0.0000205, 0.000011, 0, 0, 0]
                    float3 physics:diagonalInertia = (0.000011, 0.000011, 0.0000205)
                    float physics:mass = 0.0285
                    quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                    over "cylinder" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "base_scan" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "box_1" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "box" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }

                over "caster_back_left_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [1e-7, 1e-7, 1e-7, 0, 0, 0]
                    float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
                    float physics:mass = 0.005
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "caster_back_right_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [1e-7, 1e-7, 1e-7, 0, 0, 0]
                    float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
                    float physics:mass = 0.005
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["NewtonCollisionAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "wheel_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link/wheel_left_link>
            point3f physics:localPos0 = (0, 0.1439, 0.023)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "wheel_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link/wheel_right_link>
            point3f physics:localPos0 = (0, -0.1439, 0.023)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "caster_back_left_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link/caster_back_left_link>
            point3f physics:localPos0 = (-0.177, 0.064, -0.005237)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "caster_back_right_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link/caster_back_right_link>
            point3f physics:localPos0 = (-0.177, -0.064, -0.005237)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "scan_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </tb3_waffle_pi_lowlidar/Geometry/base_footprint/base_link/base_scan>
            point3f physics:localPos0 = (0.06, 0, 0.022)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

