#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "body" (
        prepend references = @./geometries.usd@</Geometries/body>
    )
    {
        over "body" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/body/VisualMaterials/body>
        }

        def Scope "VisualMaterials"
        {
            def Material "body" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/body>
            )
            {
            }
        }
    }

    def Xform "wheel_left" (
        prepend references = @./geometries.usd@</Geometries/wheel_left>
    )
    {
        over "wheel_left" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/wheel_left/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }

    def Xform "wheel_right" (
        prepend references = @./geometries.usd@</Geometries/wheel_right>
    )
    {
        over "wheel_right" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/wheel_right/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }
}

