#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tb3_waffle_pi_lowlidar"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tb3_waffle_pi_lowlidar" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "wheel_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_back_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_back_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "scan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_left_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "wheel_right_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "caster_back_left_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "caster_back_right_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "base_scan" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "imu_link" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }
        }
    }
}

