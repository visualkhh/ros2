<?xml version="1.0"?>
<!--
  TurtleBot3 Waffle Pi 개조형 = beebot CAD(isaac/urdf/beebot)에서 매니퓰레이터 · 맨 위 판(3층)과 그 위 · 뒤 pole·카메라를 뺀 것
  + LDS-03 라이다를 1층 맨 앞, 두 바퀴 사이 가운데에.
  2층(지금 맨 위): 앞쪽 OpenCR · 뒤쪽 Raspberry Pi 4 · 모서리 지지봉(standoff)은 그대로 위로 솟아 있음 (2026-10-27 사진).

  메시: body.stl · wheel_*.stl ← isaac/urdf/beebot/make_tb3_body.py가 beebot 메시에서 만듦 (mm, scale 0.001).

  ★ 같은 파일이 두 곳 (의도적 분리, 내용은 글자까지 같게):
      ros2_ws/src/tb3_bringup/urdf/robot.urdf.xacro  — ROS (robot_state_publisher · RViz)
      isaac/urdf/beebot/urdf.xacro                   — Isaac 학습
    고치면 둘 다 고치고 isaac/urdf/check_same.sh 로 확인. 다른 건 메시 위치뿐 → xacro 인자 mesh_uri.
  ★ 실측해서 고칠 값 = 아래 property 중 "측정" 표시. 바꾸면 colcon build 후 view-model로 다시 확인.

  좌표 (REP-105): base_footprint(바닥, 루트) → base_link(바퀴축 아래, +0.010) — x 앞 · y 왼쪽 · z 위.
  드라이버가 odom→base_footprint를 낸다. 아래 값은 전부 base_link 기준.
  몸통 외곽: x -0.197 ~ +0.069 (앞끝 0.069) · y ±0.139 · z -0.010(캐스터) ~ 0.091(지지봉 끝).
-->
<robot name="tb3_waffle_pi_lowlidar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 메시 폴더: ROS는 기본값 그대로 · Isaac은 isaac/urdf/beebot/meshes 를 넘김 (robot_spec.py) -->
  <xacro:arg name="mesh_uri" default="package://tb3_bringup/meshes"/>

  <!-- LDS-03 라이다. base_scan = 스캔 평면 중심 = coin_d4_driver frame_id -->
  <xacro:property name="lidar_x" value="0.060"/>           <!-- 측정: 라이다 중심 — 바퀴축(0)보다 앞, 판 앞끝(0.069) 근처 -->
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.022"/>           <!-- 측정: 스캔 평면 높이 (1층 판 위, 2층 판 아래) -->
  <xacro:property name="lidar_yaw" value="0.0"/>           <!-- 측정: 라이다 0°가 로봇 앞과 다르면 (rad) -->
  <xacro:property name="lidar_w" value="0.0547"/>          <!-- LDS-03 e-Manual 54.7 W × 39.7 D × 34 H mm -->
  <xacro:property name="lidar_d" value="0.0397"/>
  <xacro:property name="lidar_h" value="0.034"/>

  <material name="body"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="lidar"><color rgba="0.85 0.25 0.1 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.010"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="$(arg mesh_uri)/body.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="body"/>
    </visual>
    <!-- 1층~2층 + 지지봉 (판 266×266mm, 중심 x -0.064) -->
    <collision>
      <origin xyz="-0.064 0 0.0455"/>
      <geometry><box size="0.266 0.266 0.091"/></geometry>
    </collision>
    <!-- 근사: Waffle Pi 1.8 kg에서 위판 뺀 몸체 (배터리·모터·보드·라이다). Isaac 학습용 — 바꾸면 isaac 재학습 -->
    <inertial>
      <origin xyz="-0.064 0 0.030"/>
      <mass value="1.4"/>
      <inertia ixx="0.0090" ixy="0" ixz="0" iyy="0.0090" iyz="0" izz="0.0165"/>
    </inertial>
  </link>

  <!-- 바퀴 (beebot CAD 위치·메시). +회전 = 앞으로 -->
  <xacro:macro name="wheel" params="side y">
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/><child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0.023"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="wheel_${side}_link">
      <visual>
        <geometry><mesh filename="$(arg mesh_uri)/wheel_${side}.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder length="0.015" radius="0.033"/></geometry>
      </collision>
      <inertial>
        <mass value="0.0285"/>
        <inertia ixx="1.1e-05" ixy="0" ixz="0" iyy="2.05e-05" iyz="0" izz="1.1e-05"/>
      </inertial>
    </link>
  </xacro:macro>
  <xacro:wheel side="left" y="0.1439"/>
  <xacro:wheel side="right" y="-0.1439"/>

  <!-- 볼 캐스터 (모양은 body.stl에 있음 · 여기는 접지 구만). Isaac은 'caster' 충돌체에 마찰 0을 붙인다 (볼이 굴러감) -->
  <xacro:macro name="caster" params="side y">
    <joint name="caster_back_${side}_joint" type="fixed">
      <parent link="base_link"/><child link="caster_back_${side}_link"/>
      <origin xyz="-0.177 ${y} -0.005237"/>
    </joint>
    <link name="caster_back_${side}_link">
      <collision><geometry><sphere radius="0.004763"/></geometry></collision>
    </link>
  </xacro:macro>
  <xacro:caster side="left" y="0.064"/>
  <xacro:caster side="right" y="-0.064"/>

  <!-- OpenCR 내장 IMU (beebot 실측: 보드 윗면). 축은 base_link와 같다고 가정 — 왼쪽 회전에 gz > 0 확인 -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.0178 0 0.0585"/>
  </joint>
  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/><child link="base_scan"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/>
  </joint>
  <link name="base_scan">
    <!-- LDS-03 외형 (상자로 근사, 스캔 평면이 높이 중앙이라고 가정) -->
    <visual>
      <geometry><box size="${lidar_d} ${lidar_w} ${lidar_h}"/></geometry>
      <material name="lidar"/>
    </visual>
    <collision>
      <geometry><box size="${lidar_d} ${lidar_w} ${lidar_h}"/></geometry>
    </collision>
  </link>
</robot>
