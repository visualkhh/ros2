<?xml version="1.0"?>
<!-- TurtleBot3 Manipulation -->
<robot name="turtlebot3_manipulation" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="false" />

  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="fake_sensor_commands" default="false" />

  <xacro:arg name="opencr_port" default="/dev/ttyACM0"/>
  <xacro:arg name="camera_mount_xyz" default="0.1061547 0 0.065"/>
  <xacro:arg name="camera_mount_rpy" default="0 0 0"/>
  <xacro:include filename="d435.urdf.xacro"/>
  <xacro:sensor_d435 parent="$(arg prefix)base_link" name="$(arg prefix)camera"
      use_nominal_extrinsics="${'$(arg use_sim)' == 'true' or '$(arg use_fake_hardware)' == 'true'}">
    <origin xyz="$(arg camera_mount_xyz)" rpy="$(arg camera_mount_rpy)"/>
  </xacro:sensor_d435>
  <joint name="$(arg prefix)mount_joint" type="fixed">
    <parent link="$(arg prefix)camera_bottom_screw_frame"/><child link="$(arg prefix)d435_mount"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="$(arg prefix)d435_mount">
    <visual><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/mount/D435_A1_PLA.stl" scale="0.001 0.001 0.001"/></geometry><material name="mount_teal"><color rgba="0.10 0.52 0.55 1"/></material></visual>
    <visual><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/mount/D435_fasteners.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"><color rgba="0.68 0.70 0.74 1"/></material></visual>
    <collision><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/mount/D435_A1_PLA.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="-0.040 0 0.025"/><mass value="0.040"/><inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00012"/></inertial>
  </link>

  <xacro:include filename="$(find turtlebot3_manipulation_description)/gazebo/materials.xacro" />

  <!-- Include TurtleBot3 Waffle Pi urdf macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_description)/urdf/turtlebot3_waffle_pi.urdf.xacro" />


  <!-- Include OpenManipulator-X urdf macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_description)/urdf/open_manipulator_x.urdf.xacro" />


  <!-- Include TurtleBot3 Manipulation ros2 control macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_description)/ros2_control/turtlebot3_manipulation_system.ros2_control.xacro" />

  <xacro:turtlebot3_waffle_pi prefix="$(arg prefix)" />

  <!-- Used for fixing OpenManipulator-X on TurtleBot3 Waffle Pi -->
  <joint name="$(arg prefix)base_fixed" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)link1"/>
    <origin xyz="-0.092 0.0 0.091" rpy="0 0 0"/>
  </joint>

  <xacro:open_manipulator_x prefix="$(arg prefix)" />

  <xacro:turtlebot3_manipulation_system
    name="TurtleBot3ManipulationSystem" prefix="$(arg prefix)" use_sim="$(arg use_sim)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"/>

</robot>
