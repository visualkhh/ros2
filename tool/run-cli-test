#!/usr/bin/env bash
# run-cli-test — cli-test/{start,stop,restart}.sh 실행기. 기본은 start.
#   ./tool/run-cli-test status
#   ./tool/run-cli-test node-status /controller_server
#   ./tool/run-cli-test stop
set -eo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-start}"
case "$cmd" in
  start)
    [ $# -gt 0 ] && shift
    exec "$HERE/cli-test/start.sh" "$@"
    ;;
  stop)
    exec "$HERE/cli-test/stop.sh"
    ;;
  restart)
    [ $# -gt 0 ] && shift
    exec "$HERE/cli-test/restart.sh" "$@"
    ;;
  *)
    exec "$HERE/cli-test/start.sh" "$@"
    ;;
esac
