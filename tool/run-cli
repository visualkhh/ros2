#!/usr/bin/env bash
# run-cli — 로봇 운영 CLI. ROS 토픽이 보이는 곳 어디서나 (로봇 Pi든 PC든). 자세히: tool/README.md · tool/MAP_NAV.md
#
#   ./run-cli                      대화형 메뉴 (TTY 아니면 status)
#   ./run-cli <명령> [...]          한 번 실행 — 명령 목록·옵션: 아래 (또는 ./run-cli <명령> --help)
#   ./run-cli stop                 실행 중인 CLI 프로세스 종료 (띄운 SLAM·Nav는 계속 돔 → stop-all)
#   ./run-cli restart              CLI 프로세스 재시작
#   ./run-cli -h | --help          이 도움말
#
# 자주 쓰는 것:
#   ./run-cli status                         프로세스 · 로봇 · 모드/RL/비상정지 · odom·scan·map
#   ./run-cli base start                     바퀴·odom·라이다 (tb-only)
#   ./run-cli slam start | map save office | slam stop
#   ./run-cli nav start office | initpose 0 0 0 | goal 1.0 0.5 90
#   ./run-cli teleop                         w/x/a/d · s 정지 · q 종료
#   ./run-cli mode manual|auto · rl on|off · estop on|off
#
# 로봇이 아닌 곳에서는 켜기/끄기·지도·로그를 SSH(pak@pak.local)로 로봇에 넘깁니다. ROS_DOMAIN_ID=25 고정.
set -eo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-start}"
case "$cmd" in
  -h|--help)
    sed -n '2,/^set -eo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    echo "명령 목록 (robot_tool.py):"
    exec "$HERE/cli/start.sh" --help 2>/dev/null | sed -n '/^usage:/,$p'
    ;;
  start)
    [ $# -gt 0 ] && shift
    exec "$HERE/cli/start.sh" "$@"
    ;;
  stop)
    exec "$HERE/cli/stop.sh"
    ;;
  restart)
    exec "$HERE/cli/restart.sh"
    ;;
  *)
    exec "$HERE/cli/start.sh" "$@"
    ;;
esac
